{
  "name": "division-report-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test --test-concurrency=8 src/**/*.test.ts",
    "dev": "tsx watch src/app/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@hapi/boom": "^9.1.4",
    "baileys": "^6.7.24",
    "drizzle-orm": "^0.44.6",
    "exceljs": "^4.4.0",
    "fastify": "^5.7.1",
    "googleapis": "^174.0.1",
    "pg": "^8.16.3",
    "pg-boss": "^10.3.2",
    "pino": "^9.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
