# Copy to .env and fill in. No real value belongs in this repository.

# --- Database ---------------------------------------------------------
# Its own database and role, never shared with another service.
DATABASE_URL=postgresql://whatsapp_division:CHANGEME@localhost:5432/whatsapp_division

# --- LLM gateway (LiteLLM) --------------------------------------------
LITELLM_BASE_URL=http://localhost:4000
# LiteLLM alias to request. Must be one the gateway serves (deepseek-flash / deepseek-v4-pro as of 2026-09).
WDH_LLM_MODEL=deepseek-v4-flash
LITELLM_API_KEY=

# --- WhatsApp ---------------------------------------------------------
# The group the bot listens to. Baileys writes its pairing state into the
# auth folder; treat that folder as a credential — whoever holds it can
# send messages as the bot.
WHATSAPP_GROUP_JID=000000000000000000@g.us
WHATSAPP_AUTH_FOLDER=./baileys-session

# --- Google Sheets ----------------------------------------------------
# Service-account JSON on disk, and the spreadsheet it may write to.
SHEETS_CREDENTIALS_PATH=./google-sheets-service-account.json
SHEETS_SPREADSHEET_ID=
# Optional: member_id credited as the actor for admin edits made in the sheet.
SHEETS_ADMIN_ACTOR_MEMBER_ID=

# --- Server -----------------------------------------------------------
PORT=8020
NODE_ENV=development
